{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node scripts/*)",
      "Bash(node .claude/skills/*)",
      "Bash(npx kill-port *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore --staged *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch --show-current)",
      "Bash(netstat -ano *)",
      "Bash(mkdir -p *)",
      "Bash(date *)",
      "PowerShell(pnpm *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "Edit(/src/**)",
      "Edit(/docs/**)",
      "Edit(/tests/**)",
      "Edit(/public/**)",
      "Edit(/scripts/sync/sources/**)",
      "mcp__aicoder__browser_*",
      "mcp__context7__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-forced-eval.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.cjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
