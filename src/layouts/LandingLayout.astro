---
// docs 模块的营销页布局：src/data/landing.json 登记的文档（产品矩阵、技术服务、演示、更新日志……）换这个布局，正文仍是迁来的 .md（一个字不改）。
// 版式分工：开头 h1 + 导语由 rehypeLandingHero 包进 <header class="lp-hero">，这里的样式把它铺成整宽深色首屏；
// 正文各段按页挂 lp-<id> 类，由 landing.css 排版（卡片、网格、时间线）。长页（changelog / comparison）的章节条也由插件按 h2 生成（landing.json 的 chapters）；
// 首屏深色带用 box-shadow 横向铺满，所以不再放左侧栏（会被盖住）；演示页的手机实时预览放右栏、叠在首屏上（同为深色卡片）。
// SEO 与结构化数据和文档页一致（TechArticle + 全站四种），title / description / canonical 与旧站逐字相同
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocsPhonePreview from '@/components/docs/DocsPhonePreview.astro';
import ImageViewer from '@/components/docs/ImageViewer.astro';
import ContactDialog from '@/components/docs/ContactDialog.astro';
import { absoluteUrl, type JsonLd } from '@/lib/seo';
import { docPath } from '@/lib/docs';
import { isoDate } from '@/lib/lastmod';
import { docsConfig } from '@/lib/docs-config';
import { site } from '@/site.config';
import { siteJsonLd } from '@/lib/site-jsonld';
import titleQualifiers from '@/data/title-qualifiers.json';
import '@/styles/vp-compat.css';
import '@/styles/docs-theme.css';
import '@/styles/docs-content.css';
import '@/styles/landing.css';
// 品牌样式最后引入（各站配色 / 首屏底 / 渐变的覆盖，项目文件）
import '@/styles/brand.css';

interface Props {
  id: string;
  title: string;
  description: string;
  /** 最后更新日期（frontmatter lastUpdated）：营销页版式不显示，只进 TechArticle.dateModified */
  lastUpdated?: Date;
  /** 本页 meta keywords（frontmatter keywords），不传用全站的 */
  keywords?: string;
  headings: MarkdownHeading[];
  iframe?: boolean;
  url?: string;
  /** 与 DocsLayout 同一组属性（路由统一传），营销页不显示右侧页面导航，用不到 */
  aside?: boolean;
}

const { id, title, description, lastUpdated, keywords, iframe = false, url } = Astro.props;
const updated = docsConfig.lastUpdated !== 'off' && lastUpdated ? isoDate(lastUpdated) : undefined;
const showPreview = iframe && url;
const qualifier = (titleQualifiers as Record<string, string>)[id];
const pageTitle = qualifier ? `${title} · ${qualifier}` : title;
const techArticle: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  ...(description ? { description } : {}),
  url: absoluteUrl(docPath(id)),
  ...(updated ? { dateModified: updated } : {}),
  inLanguage: site.locale,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  // about / author / publisher 与 DocsLayout 同一口径（docs.json 的 article）
  about: docsConfig.article.about,
  proficiencyLevel: docsConfig.article.proficiencyLevel,
  author: docsConfig.article.author ?? { '@type': 'Organization', name: site.author.name, url: site.url },
  ...(docsConfig.article.publisher ? { publisher: docsConfig.article.publisher } : {}),
};
---

<BaseLayout title={pageTitle} description={description} keywords={keywords} type="article" jsonLd={[...siteJsonLd, techArticle]}>
  <div class:list={['lp', `lp-${id}`, showPreview && 'lp-with-preview', site.codeLineNumbers && 'code-line-numbers']}>
    <div class="lp-grid">
      <article class="prose-content vp-doc" data-pagefind-body>
        <slot />
      </article>
      {
        showPreview && (
          <aside class="lp-preview">
            <div>
              <DocsPhonePreview url={url} height={560} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
  <ImageViewer />
  <ContactDialog fab />
</BaseLayout>

<script>
  // 代码窗「复制」按钮（与 DocsLayout 同一段；营销页代码块很少，单独留一份免得为它拆公共模块）
  for (const pre of document.querySelectorAll<HTMLPreElement>('.vp-doc pre.astro-code')) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'ry-copy';
    button.textContent = '复制';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        button.textContent = '已复制';
      } catch {
        button.textContent = '复制失败';
      }
      setTimeout(() => (button.textContent = '复制'), 1600);
    });
    pre.append(button);
  }
</script>
