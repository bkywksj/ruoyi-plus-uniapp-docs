---
// 指南详情页布局：左目录 / 正文 / 右「本页内容」三栏（窄屏收成顶部可展开的目录），外壳仍是 BaseLayout。
// 用 Container 默认宽度（max-w-6xl）放三栏，不另开更宽的版心，免得改框架核心组件。
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import GuideSidebar from '@/components/docs/GuideSidebar.astro';
import GuideToc from '@/components/docs/GuideToc.astro';
import GuideMeta from '@/components/docs/GuideMeta.astro';
import PrevNext from '@/components/docs/PrevNext.astro';
import SearchButton from '@/components/docs/SearchButton.astro';
import Lightbox from '@/components/docs/Lightbox.astro';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd, pagePath, type Crumb } from '@/lib/seo';
import { formatDate, isoDate } from '@/lib/format';
import { guidePath, prevNext, type Guide } from '@/lib/guides';

interface Props {
  guide: Guide;
  /** 全部已发布指南（已排序），侧栏与上下篇都用它 */
  guides: Guide[];
  headings: MarkdownHeading[];
}

const { guide, guides, headings } = Astro.props;
const { title, description, section, duration, version, prepare, faq, updated, lead } = guide.data;
const path = guidePath(guide.id);
const crumbs: Crumb[] = [
  { name: '首页', path: '/' },
  { name: '使用指南', path: pagePath('/guide') },
  { name: title, path },
];
const { prev, next } = prevNext(guides, guide.id);
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  articleJsonLd({ title, description, path, datePublished: updated, dateModified: updated }),
  // FAQPage 只在页尾真有问答时输出，问答与页面上展开的内容同源
  ...(faq.length > 0 ? [faqJsonLd(faq.map((f) => ({ question: f.q, answer: f.a })))] : []),
];
---

<BaseLayout title={title} description={description} type="article" modifiedTime={updated} jsonLd={jsonLd}>
  <Container class="py-8 sm:py-10">
    <div class="grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] xl:grid-cols-[13rem_minmax(0,1fr)_10rem]">
      <aside class="hidden lg:block">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-6">
          <SearchButton class="mb-6" />
          <GuideSidebar guides={guides} currentId={guide.id} />
        </div>
      </aside>

      <div class="min-w-0">
        <!-- 窄屏：目录收进可展开的 details，零 JS -->
        <details class="mb-6 rounded-lg border border-line lg:hidden" data-guide-mobile-nav>
          <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium">使用指南目录</summary>
          <div class="border-t border-line px-1 py-4">
            <SearchButton class="mx-2 mb-4 w-auto" />
            <GuideSidebar guides={guides} currentId={guide.id} />
          </div>
        </details>

        <Breadcrumbs crumbs={crumbs} />
        <article class="mt-6" data-pagefind-body>
          <p class="text-sm font-semibold tracking-wide text-brand-ink" data-pagefind-meta="section">
            {section}
          </p>
          <h1 class="mt-1.5 text-3xl leading-tight font-bold tracking-tight text-pretty sm:text-[2.375rem]">
            {title}
          </h1>
          {lead && <p class="mt-3 text-lg leading-8 text-muted">{description}</p>}
          <GuideMeta duration={duration} version={version} prepare={prepare} />
          <div class="prose-content mt-8">
            <slot />
          </div>
          {faq.length > 0 && (
            <section class="mt-12" aria-labelledby="faq">
              <h2 id="faq" class="text-xl font-semibold">
                常见问题
              </h2>
              <div class="mt-4 divide-y divide-line rounded-[var(--radius-card)] border border-line bg-elevated shadow-[var(--shadow-card)]">
                {faq.map((f) => (
                  <details class="px-4 py-3">
                    <summary class="cursor-pointer font-medium">{f.q}</summary>
                    <p class="mt-2 leading-7 text-muted">{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </article>
        <PrevNext prev={prev} next={next} />
        <p class="mt-6 text-xs text-muted">
          最后更新：<time datetime={isoDate(updated)}>{formatDate(updated)}</time>
        </p>
      </div>

      <aside class="hidden xl:block">
        <div class="sticky top-20">
          <GuideToc headings={headings} />
        </div>
      </aside>
    </div>
  </Container>
  <Lightbox />
</BaseLayout>
