---
// 迁移文档的页面布局：左多层侧栏 / 正文 / 右「页面导航」或手机实时预览，外壳是 BaseLayout。
// 版心比框架 Container 宽（文档代码块多，正文需要宽度），只在这个布局里放宽，不改框架核心组件。
// 结构化数据照旧站：每页 TechArticle（字段与旧站 transformPageData 一致），不再加 BreadcrumbList 以外的东西
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SidebarTree from '@/components/docs/SidebarTree.astro';
import DocsToc from '@/components/docs/DocsToc.astro';
import PhonePreview from '@/components/docs/PhonePreview.astro';
import { absoluteUrl, type JsonLd } from '@/lib/seo';
import { docPath, prevNextOf, sectionOf, sidebarOf } from '@/lib/docs';
import { site } from '@/site.config';
import { siteJsonLd } from '@/lib/site-jsonld';
import titleQualifiers from '@/data/title-qualifiers.json';
import '@/styles/vp-compat.css';
import '@/styles/docs-ruoyi.css';

interface Props {
  id: string;
  title: string;
  description: string;
  headings: MarkdownHeading[];
  iframe?: boolean;
  url?: string;
  aside?: boolean;
}

const { id, title, description, headings, iframe = false, url, aside = true } = Astro.props;
const section = sectionOf(id);
const sidebar = section ? sidebarOf(section) : [];
const { prev, next } = prevNextOf(id);
const showPreview = iframe && url;
const current = docPath(id);
// 旧站 16 组页面 <title> 完全相同（如 4 页都叫「快速开始」）：只在 <title> 里加区分名，正文 h1 与结构化数据标题不变
// （区分名由 scripts/migrate/title-qualifiers.mjs 生成，用户 2026-10-30 定）
const qualifier = (titleQualifiers as Record<string, string>)[id];
const pageTitle = qualifier ? `${title} · ${qualifier}` : title;
const techArticle: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  ...(description ? { description } : {}),
  url: absoluteUrl(docPath(id)),
  inLanguage: 'zh-CN',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  author: { '@type': 'Person', name: '抓蛙师' },
  publisher: { '@type': 'Organization', name: site.author.name, url: site.url },
  proficiencyLevel: 'Beginner',
  about: ['RuoYi-Plus-UniApp', 'Spring Boot 3', 'Vue 3', 'UniApp'],
};
// 旧站「在 GitHub 上编辑此页面」：pattern https://github.com/bkywksj/ruoyi-plus-uniapp-docs/edit/master/docs/:path
const editUrl = `https://github.com/bkywksj/ruoyi-plus-uniapp-docs/edit/master/docs/${id}.md`;
---

<BaseLayout title={pageTitle} description={description} type="article" jsonLd={[...siteJsonLd, techArticle]}>
  <div class:list={['mx-auto w-full max-w-[90rem] px-4 py-8 sm:px-6 lg:px-8', site.codeLineNumbers && 'code-line-numbers']}>
    <div
      class:list={[
        'grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]',
        showPreview ? 'xl:grid-cols-[16rem_minmax(0,1fr)_22.5rem]' : aside && 'xl:grid-cols-[16rem_minmax(0,1fr)_13rem]',
      ]}
    >
      {
        sidebar.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2 pb-6 text-sm">
              <SidebarTree items={sidebar} current={current} />
            </div>
          </aside>
        )
      }

      <div class:list={['min-w-0', sidebar.length === 0 && 'lg:col-span-2']}>
        {
          sidebar.length > 0 && (
            <details class="mb-6 rounded-lg border border-line text-sm lg:hidden">
              <summary class="cursor-pointer px-4 py-2.5 font-medium">菜单</summary>
              <div class="border-t border-line px-2 py-4">
                <SidebarTree items={sidebar} current={current} />
              </div>
            </details>
          )
        }
        <article class="prose-content vp-doc" data-pagefind-body>
          <slot />
        </article>
        {
          (prev || next) && (
            <nav aria-label="上一篇与下一篇" class="not-prose mt-12 grid gap-4 border-t border-line pt-6 text-sm sm:grid-cols-2">
              {prev?.href ? (
                <a href={prev.href} rel="prev" class="rounded-lg border border-line p-4 transition-colors hover:border-brand">
                  <span class="text-xs text-muted">上一页</span>
                  <span class="mt-1 block font-medium text-brand-ink">{prev.text}</span>
                </a>
              ) : (
                <span />
              )}
              {next?.href && (
                <a href={next.href} rel="next" class="rounded-lg border border-line p-4 text-right transition-colors hover:border-brand">
                  <span class="text-xs text-muted">下一页</span>
                  <span class="mt-1 block font-medium text-brand-ink">{next.text}</span>
                </a>
              )}
            </nav>
          )
        }
        <p class="mt-6 text-sm">
          <a href={editUrl} target="_blank" rel="noopener" class="text-brand-ink hover:underline">在 GitHub 上编辑此页面</a>
        </p>
      </div>

      {
        showPreview ? (
          <aside class="hidden xl:block">
            <div class="sticky top-20">
              <PhonePreview url={url} />
            </div>
          </aside>
        ) : (
          aside && (
            <aside class="hidden xl:block">
              <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
                <DocsToc headings={headings} />
              </div>
            </aside>
          )
        )
      }
    </div>
  </div>
</BaseLayout>
