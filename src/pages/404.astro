---
// 404 页：浅色光晕整屏 + 终端风格的「没找到」+ 四个栏目直达 + 站内搜索。旧链接多来自 VitePress 时代，给足出路
// noindex，不参与收录类 SEO 校验；nginx 的 error_page 指向这里构建出的 404.html
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchButton from '@/components/docs/SearchButton.astro';
import { DOC_SECTIONS, SECTION_LABELS, docPath } from '@/lib/docs';
import { siteJsonLd } from '@/lib/site-jsonld';
import '@/styles/docs-theme.css';
// 品牌样式最后引入（本站配色、首屏底，见 src/styles/brand.css）
import '@/styles/brand.css';

const docs = await getCollection('docs');
const sections = DOC_SECTIONS.map((s) => ({ label: SECTION_LABELS[s], href: docPath(`${s}/index`), count: docs.filter((d) => d.id.startsWith(`${s}/`)).length }));
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动，可以回到首页重新查找需要的内容。" noindex jsonLd={siteJsonLd}>
  <section class="ry-aurora min-h-[calc(100vh-4rem)]">
    <div class="mx-auto grid w-full max-w-[70rem] items-center gap-14 px-4 py-24 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="ry-grad-text text-[120px] leading-none font-extrabold tracking-tight sm:text-[160px]">404</p>
        <h1 class="mt-4 text-[30px] font-black">页面不存在</h1>
        <p class="mt-3 text-[15.5px] leading-7 text-muted">链接可能已失效，或者内容已经移动到别处。</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/" class="ry-btn-primary inline-flex h-11 items-center rounded-full px-5 text-[14px] font-semibold">回到首页</a>
          <SearchButton tone="pill" class="!h-11 w-56" />
        </div>
      </div>
      <div class="ry-pane overflow-hidden">
        <div class="flex h-9 items-center gap-1.5 border-b border-line px-4" aria-hidden="true">
          <i class="size-2.5 rounded-full bg-[#FF5F57]"></i><i class="size-2.5 rounded-full bg-[#FEBC2E]"></i><i class="size-2.5 rounded-full bg-[#28C840]"></i>
        </div>
        <div class="p-5 font-mono text-[13px] leading-7">
          <p class="text-danger">✕ 没有找到这一页</p>
          <p class="mt-3 text-muted">您可能要找：</p>
          <ul>
            {
              sections.map((s) => (
                <li>
                  <a href={s.href} class="-mx-2 flex items-center gap-3 rounded-lg px-2 hover:bg-ink/[.04]">
                    <span class="text-brand-ink">→</span>
                    {s.label}
                    <span class="text-muted">{s.count} 页</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
