---
// 指南详情：MDX 正文 + GuideLayout 三栏。
// 文档组件在这里统一注入给 MDX（components），写指南时不用逐篇 import；只有截图图片要在 MDX 里 import。
// [...id] 而不是 [id]：glob loader 的 id 可能带子目录（guides/admin/xxx.mdx → admin/xxx）
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import GuideLayout from '@/layouts/GuideLayout.astro';
import Steps from '@/components/docs/Steps.astro';
import Callout from '@/components/docs/Callout.astro';
import MenuPath from '@/components/docs/MenuPath.astro';
import Btn from '@/components/docs/Btn.astro';
import Kbd from '@/components/docs/Kbd.astro';
import Screenshot from '@/components/docs/Screenshot.astro';
import Result from '@/components/docs/Result.astro';
import { getGuides } from '@/lib/guides';

export const getStaticPaths = (async () => {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide, guides } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { guide, guides } = Astro.props as Props;
const { Content, headings } = await render(guide);
---

<GuideLayout guide={guide} guides={guides} headings={headings}>
  <Content components={{ Steps, Callout, MenuPath, Btn, Kbd, Screenshot, Result }} />
</GuideLayout>
