---
// docs 模块的统一路由：docs 集合每页一个网址，id 即路径（guide/ipc → /guide/ipc.html，faq → /faq.html，网址形态按 site.urlFormat）
// [...slug] 而不是栏目各一个目录路由：所有栏目与根目录单页共用同一套布局，旧站网址形态由 id 原样决定
// src/data/landing.json 登记的页面换 LandingLayout；首页、栏目首页与 docs.json 的 standalonePages 由独立 .astro 页面出
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import LandingLayout from '@/layouts/LandingLayout.astro';
import landing from '@/data/landing.json';
import { docsConfig } from '@/lib/docs-config';

export const getStaticPaths = (async () => {
  // 跳过三类（🔴 只能用 import 进来的值：getStaticPaths 在独立作用域执行，引用不到组件脚本里定义的常量）：
  // - 站点首页 index：由 src/pages/index.astro 出
  // - 栏目首页 x/index：动态参数带 index 会被 Astro 归一成 /x/ 而匹配失败，由项目的目录首页路由出
  // - docs.json 的 standalonePages（如下载页）：独立页面把正文取来嵌进去，这里再出一份就是两条路由抢同一个网址
  const skip = new Set(docsConfig.standalonePages);
  const docs = (await getCollection('docs')).filter((doc) => doc.id !== 'index' && !doc.id.endsWith('/index') && !skip.has(doc.id));
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { doc } = Astro.props as Props;
const { Content, headings } = await render(doc);
const Layout = doc.id in landing.pages ? LandingLayout : DocsLayout;
---

<Layout
  id={doc.id}
  title={doc.data.title}
  description={doc.data.description}
  lastUpdated={doc.data.lastUpdated}
  keywords={doc.data.keywords}
  headings={headings}
  iframe={doc.data.iframe}
  url={doc.data.url}
  aside={doc.data.aside}
>
  <Content />
</Layout>
