---
// 关于页：站点维护者、内容来源与更新方式，是搜索引擎与 AI 判断可信度（E-E-A-T）的依据
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { breadcrumbJsonLd, type Crumb } from '@/lib/seo';
import { site } from '@/site.config';

const title = '关于本站';
const description = `关于${site.name}：站点定位、内容来源与更新方式说明。`;
const crumbs: Crumb[] = [
  { name: '首页', path: '/' },
  { name: title, path: '/about/' },
];
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbJsonLd(crumbs)]}>
  <Container size="narrow" class="py-10 sm:py-14">
    <Breadcrumbs crumbs={crumbs} />
    <article class="mt-8">
      <h1 class="mb-8 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <div class="prose-content">
        <p>{site.tagline}</p>
        <p>
          这是框架自带的示例「关于」页。孵化新项目后，请在这里写清楚：站点是谁在维护、收录什么内容、数据从哪里来、多久更新一次。
          这些信息同时是搜索引擎与 AI 判断站点可信度（E-E-A-T）的依据，只写能核实的事实。
        </p>
        <h2>联系方式</h2>
        <ul>
          {site.social.map((item) => (
            <li>
              <a href={item.href} rel="noopener me" target="_blank">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </Container>
</BaseLayout>
