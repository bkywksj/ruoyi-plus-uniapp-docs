---
// 页脚：细分隔线 + 抬升底色（语义令牌，深色模式自动翻转），站点简介 + 链接分组 + 说明行 + 版权与备案号；版心宽度跟 site.frameWidth
// 分组取 site.footerGroups；没配时退回一栏「站内」列出全部 nav。说明行、署名、备案号为空则不显示
// site.contact 有值时多一栏「联系」：每一页都找得到作者（文档页不放悬浮按钮，页脚是它们唯一的联系入口）
import { site } from '@/site.config';
import Container from '@/components/ui/Container.astro';

const year = new Date().getFullYear();
const groups = site.footerGroups.length > 0 ? site.footerGroups : [{ title: '站内', items: site.nav }];
const external = (href: string) => /^https?:/.test(href);
const contact = site.contact;
// 简介之外的栏数（链接分组 + 「关注」+「联系」），md 起按它等分
const cols = groups.length + (site.social.length > 0 ? 1 : 0) + (contact ? 1 : 0);
---

<footer data-site-footer class="border-t border-line bg-elevated text-ink">
  <Container
    size={site.frameWidth}
    class="grid grid-cols-2 gap-10 py-14 md:grid-cols-[minmax(0,1.6fr)_repeat(var(--cols),minmax(0,1fr))]"
    style={`--cols: ${cols}`}
  >
    <div class="col-span-full max-w-sm md:col-span-1">
      <p class="flex items-center gap-2.5 font-semibold">
        {
          site.logo ? (
            <img src={site.logo} alt="" width="28" height="28" class="size-7 object-contain" />
          ) : (
            <span class="size-2.5 rounded-full bg-brand" aria-hidden="true" />
          )
        }
        {site.name}
      </p>
      <p class="mt-3 text-sm leading-6 text-muted">{site.description}</p>
    </div>
    {
      groups.map((g) => (
        <nav aria-label={`页脚 · ${g.title}`}>
          <p class="text-sm font-semibold">{g.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {g.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition-colors hover:text-ink"
                  target={external(item.href) ? '_blank' : undefined}
                  rel={external(item.href) ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    {
      site.social.length > 0 && (
        <div>
          <p class="text-sm font-semibold">关注</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {site.social.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-ink" rel="noopener me" target="_blank">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      contact && (
        <div>
          <p class="text-sm font-semibold">联系</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            <li>
              微信 / QQ <span class="font-mono text-ink select-all">{contact.wechat}</span>
            </li>
            <li>
              电话{' '}
              <a href={`tel:${contact.tel}`} class="font-mono text-ink transition-colors hover:text-brand-ink">
                {contact.phone}
              </a>
            </li>
          </ul>
          <a
            href={contact.wechatQr}
            target="_blank"
            rel="noopener"
            class="group relative mt-3 inline-flex items-center gap-2.5 text-xs text-muted hover:text-ink"
            aria-label="作者微信二维码（打开大图）"
          >
            <img
              src={contact.wechatQr}
              alt="作者微信二维码"
              width="64"
              height="64"
              loading="lazy"
              class="size-16 rounded-lg border border-line bg-white object-contain p-1 transition-transform duration-300 group-hover:scale-[2.4] group-focus-visible:scale-[2.4] origin-bottom-left md:origin-bottom-right"
            />
            扫码加作者微信
          </a>
        </div>
      )
    }
  </Container>
  <Container size={site.frameWidth} class="flex flex-col gap-2 border-t border-line py-6 text-xs text-muted lg:flex-row lg:justify-between">
    {
      site.footerNote && (
        <p>
          {site.footerNote.text}
          {site.footerNote.link && (
            <a href={site.footerNote.link.href} class="text-ink/80 underline-offset-4 hover:text-ink hover:underline">
              {site.footerNote.link.label}
            </a>
          )}
        </p>
      )
    }
    <p>
      © {year} {site.copyrightName || site.author.name}
      {
        site.icp && (
          <>
            {' · '}
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="transition-colors hover:text-ink">
              {site.icp}
            </a>
          </>
        )
      }
    </p>
  </Container>
</footer>
