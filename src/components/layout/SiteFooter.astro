---
// 页脚：白底细分隔线（方案 B 浅色，语义令牌，深色模式自动翻转），站点简介 + 链接分组 + 说明行 + 版权与备案号
// 分组取 site.footerGroups；没配时退回一栏「站内」列出全部 nav。说明行、署名、备案号为空则不显示
import { site } from '@/site.config';

const year = new Date().getFullYear();
const groups = site.footerGroups.length > 0 ? site.footerGroups : [{ title: '站内', items: site.nav }];
const external = (href: string) => /^https?:/.test(href);
// 简介之外的栏数（链接分组 + 「关注」），md 起按它等分
const cols = groups.length + (site.social.length > 0 ? 1 : 0);
---

<footer class="border-t border-line bg-elevated text-ink">
  <div
    class="mx-auto grid w-full max-w-[90rem] grid-cols-2 gap-10 px-4 py-14 sm:px-6 md:grid-cols-[minmax(0,1.6fr)_repeat(var(--cols),minmax(0,1fr))] lg:px-8"
    style={`--cols: ${cols}`}
  >
    <div class="col-span-full max-w-sm md:col-span-1">
      <p class="flex items-center gap-2.5 font-semibold">
        {
          site.logo ? (
            <img src={site.logo} alt="" width="28" height="28" class="size-7 object-contain" />
          ) : (
            <span class="size-2.5 rounded-full bg-brand" aria-hidden="true" />
          )
        }
        {site.name}
      </p>
      <p class="mt-3 text-sm leading-6 text-muted">{site.description}</p>
    </div>
    {
      groups.map((g) => (
        <nav aria-label={`页脚 · ${g.title}`}>
          <p class="text-sm font-semibold">{g.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {g.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="transition-colors hover:text-ink"
                  target={external(item.href) ? '_blank' : undefined}
                  rel={external(item.href) ? 'noopener' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    {
      site.social.length > 0 && (
        <div>
          <p class="text-sm font-semibold">关注</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {site.social.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-ink" rel="noopener me" target="_blank">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <div
    class="mx-auto flex w-full max-w-[90rem] flex-col gap-2 border-t border-line px-4 py-6 text-xs text-muted sm:px-6 lg:flex-row lg:justify-between lg:px-8"
  >
    {
      site.footerNote && (
        <p>
          {site.footerNote.text}
          {site.footerNote.link && (
            <a href={site.footerNote.link.href} class="text-ink/80 underline-offset-4 hover:text-ink hover:underline">
              {site.footerNote.link.label}
            </a>
          )}
        </p>
      )
    }
    <p>
      © {year} {site.copyrightName || site.author.name}
      {
        site.icp && (
          <>
            {' · '}
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="transition-colors hover:text-ink">
              {site.icp}
            </a>
          </>
        )
      }
    </p>
  </div>
</footer>
