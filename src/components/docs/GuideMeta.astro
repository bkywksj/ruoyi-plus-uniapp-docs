---
// 指南开头的信息卡：预计用时 / 适用版本 / 需要准备（数据来自 frontmatter，三项都可省，全省则不渲染）
import { Clock, BadgeCheck, Package } from '@lucide/astro';

interface Props {
  duration?: string;
  version?: string;
  prepare?: string;
}

const { duration, version, prepare } = Astro.props;
const cells = [
  ...(duration ? [{ label: '预计用时', value: duration, Icon: Clock, tone: 'text-brand-ink' }] : []),
  ...(version ? [{ label: '适用版本', value: `v${version} 及以上`, Icon: BadgeCheck, tone: 'text-brand-ink' }] : []),
  ...(prepare ? [{ label: '需要准备', value: prepare, Icon: Package, tone: 'text-accent-ink' }] : []),
];
---

{
  cells.length > 0 && (
    <dl class="not-prose mt-6 grid gap-3 sm:grid-cols-3" data-pagefind-ignore>
      {cells.map(({ label, value, Icon, tone }) => (
        <div class="rounded-[var(--radius-card)] border border-line bg-surface px-4 py-3">
          <dt class="text-xs text-muted">{label}</dt>
          <dd class="mt-1 flex items-center gap-1.5 text-sm font-medium text-ink">
            <Icon class:list={['size-4 shrink-0', tone]} aria-hidden="true" />
            {value}
          </dd>
        </div>
      ))}
    </dl>
  )
}
