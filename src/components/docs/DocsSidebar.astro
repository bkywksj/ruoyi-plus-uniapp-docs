---
// 多层侧栏（递归）：分组可折叠，用原生 <details> 零 JS；默认折叠状态照旧站，当前页所在的分组强制展开
// 框架的 GuideSidebar 只有一层分组，旧站侧栏有三层（分组 → 子分组 → 页面），所以单独写
import { containsId, docPath, type SidebarItem } from '@/lib/docs';

interface Props {
  items: SidebarItem[];
  currentId: string;
  depth?: number;
}

const { items, currentId, depth = 0 } = Astro.props;
---

<ul class:list={['space-y-0.5', depth > 0 && 'mt-0.5 border-l border-line pl-3']}>
  {
    items.map((item) => {
      const active = item.id === currentId;
      const link = item.id ? docPath(item.id) : item.href;
      const label = link ? (
        <a
          href={link}
          aria-current={active ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          class:list={[
            'block rounded-md px-2 py-1 transition-colors',
            active ? 'bg-brand-soft font-medium text-brand-ink' : 'text-muted hover:text-ink',
          ]}
        >
          {item.text}
        </a>
      ) : null;
      if (!item.items) return <li>{label}</li>;
      const open = item.collapsed === undefined || !item.collapsed || containsId(item, currentId);
      return (
        <li class:list={[depth === 0 && 'mb-4']}>
          <details open={open} class="group">
            <summary
              class:list={[
                'flex cursor-pointer list-none items-center justify-between rounded-md px-2 py-1 [&::-webkit-details-marker]:hidden',
                depth === 0 ? 'text-sm font-semibold text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              <span>{item.text}</span>
              {item.collapsed !== undefined && (
                <svg viewBox="0 0 24 24" class="size-3.5 shrink-0 transition-transform group-open:rotate-90" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              )}
            </summary>
            {label && <div class="mt-0.5">{label}</div>}
            <Astro.self items={item.items} currentId={currentId} depth={depth + 1} />
          </details>
        </li>
      );
    })
  }
</ul>
