---
// 菜单路径胶囊：<MenuPath to="设置 > 账号 > 安全" />。文字要与产品界面逐字一致，读者是照着找的
import { ChevronRight } from '@lucide/astro';

interface Props {
  /** 用 > 分隔的菜单层级 */
  to: string;
}

const parts = Astro.props.to
  .split('>')
  .map((s) => s.trim())
  .filter(Boolean);
---

<span class="inline-flex flex-wrap items-center gap-1 align-baseline">
  {
    parts.map((part, i) => (
      <>
        {i > 0 && <ChevronRight class="size-3.5 text-muted" aria-hidden="true" />}
        <span class="rounded-md bg-surface px-2 py-0.5 text-[0.9em] whitespace-nowrap text-ink ring-1 ring-line">{part}</span>
      </>
    ))
  }
</span>
