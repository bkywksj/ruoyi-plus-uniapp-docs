---
// 打开站内搜索的按钮（外观像输入框）；真正的弹窗在 SearchDialog，页头里放一次
import { Search } from '@lucide/astro';

interface Props {
  /** md = 侧栏 / 页头；lg = 指南首页的大搜索框 */
  size?: 'md' | 'lg';
  /** lg 尺寸的占位文案，写几个本站常被搜的词 */
  placeholder?: string;
  /** dark = 放在常驻深色的页头 / 首屏上（浅色令牌在深底上对比度不够） */
  tone?: 'light' | 'dark';
  class?: string;
}

const { size = 'md', placeholder = '搜索文档', tone = 'light', class: className } = Astro.props;
const dark = tone === 'dark';
---

<button
  type="button"
  data-search-open
  class:list={[
    // 浅色款沿用占满父容器；深色款放在页头这类横排里，宽度由调用方给（w-full 会和调用方的 w-44 打架，把旁边的按钮挤出去）
    'flex items-center gap-2 rounded-lg border text-left transition-colors',
    dark
      ? 'border-white/10 bg-white/[.04] text-white/50 hover:border-white/20 hover:text-white/80'
      : 'w-full border-line bg-elevated text-muted hover:border-brand',
    size === 'lg' ? 'px-4 py-3 text-[15px] shadow-[var(--shadow-card)]' : dark ? 'px-3 py-1.5 text-[13px]' : 'px-3 py-2 text-sm',
    className,
  ]}
>
  <Search class={size === 'lg' ? 'size-5' : dark ? 'size-3.5' : 'size-4'} aria-hidden="true" />
  <span class="flex-1 truncate">{size === 'lg' ? placeholder : '搜索文档'}</span>
  <kbd
    class:list={[
      'rounded border px-1.5 py-0.5 font-mono',
      dark ? 'border-white/10 text-[10px] text-white/40' : 'border-line bg-surface text-xs',
    ]}>Ctrl K</kbd
  >
</button>
