---
// 指南左侧目录：按分组列出全部篇目，当前篇高亮（分组顺序见 src/lib/guide-sections.ts）
import type { Guide } from '@/lib/guides';
import { groupBySection, guidePath } from '@/lib/guides';

interface Props {
  guides: Guide[];
  currentId?: string;
}

const { guides, currentId } = Astro.props;
const groups = groupBySection(guides);
---

<nav aria-label="使用指南目录" class="text-sm">
  {
    groups.map(({ section, items }) => (
      <div class="mb-6">
        <p class="px-3 text-xs font-semibold tracking-wider text-muted">{section}</p>
        <ul class="mt-2 space-y-0.5">
          {items.map((g) => {
            const active = g.id === currentId;
            return (
              <li>
                <a
                  href={guidePath(g.id)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-1.5 transition-colors',
                    active ? 'bg-brand-soft font-medium text-brand-ink' : 'text-muted hover:bg-surface hover:text-ink',
                  ]}
                >
                  {g.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
