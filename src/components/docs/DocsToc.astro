---
// 右侧「页面导航」：二、三级标题（旧站 outline.level = [2, 3]，标签「页面导航」），纯链接零 JS
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="页面导航" class="text-xs">
      <p class="font-semibold tracking-wider text-muted">页面导航</p>
      <ul class="mt-3 space-y-1.5 border-l border-line">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={[
                '-ml-px block border-l border-transparent text-muted hover:border-brand hover:text-brand-ink',
                h.depth === 2 ? 'pl-3' : 'pl-6',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
