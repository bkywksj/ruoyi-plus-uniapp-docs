---
// 界面截图：圆角阴影 + 图注 + 点击放大（放大层是 GuideLayout 里唯一的 <dialog>，见 Lightbox.astro）。
// 正文栏里出多尺寸 webp；放大用原尺寸 webp，看得清小字。
//
// 用法：MDX 里 import 图片后传进来
//   import shot from '@/assets/guides/settings.png';
//   <Screenshot src={shot} alt="设置页" marks={[[12, 30, 40, 8], [12, 46, 40, 8]]} />
// marks = 按顺序画 1 2 3 编号框，坐标是占整图的百分比 [左, 上, 宽, 高]，与显示尺寸无关；
// 截图后用任意看图工具量一下即可，正文里用同样的编号指代。
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { ZoomIn } from '@lucide/astro';

type Box = [number, number, number, number];

interface Props {
  src: ImageMetadata;
  /** 描述图里是什么界面，读屏与搜索引擎都用它 */
  alt: string;
  /** 图注；省略时用 alt */
  caption?: string;
  /** 要编号标出的区域（百分比），按出现顺序编 1 2 3 */
  marks?: Box[];
}

const { src, alt, caption, marks = [] } = Astro.props;
// 坐标越界多半是把像素当成了百分比：静默画到图外比报错难发现得多，直接让构建失败
marks.forEach(([x, y, w, h], i) => {
  if ([x, y, w, h].some((v) => v < 0 || v > 100) || x + w > 100.5 || y + h > 100.5) {
    throw new Error(`Screenshot：第 ${i + 1} 个标注框超出图片范围（坐标是百分比 [左, 上, 宽, 高]，不是像素）：${alt}`);
  }
});

/** 编号放框外：默认左侧；框贴左边（< 4%）放上方；左、上都贴边放右侧，避免压住要标的字 */
const edgeOf = ([x, y]: Box) => (x < 4 ? (y < 4 ? 'right' : 'top') : 'left') as 'left' | 'top' | 'right';
const badgePos = {
  left: 'top-1/2 -left-7 -translate-y-1/2',
  top: '-top-7 left-0',
  right: 'top-1/2 -right-7 -translate-y-1/2',
} as const;

const full = await getImage({ src, format: 'webp', width: src.width });
const label = caption ?? alt;
---

<figure class="not-prose my-6">
  <button
    type="button"
    class="group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border border-line bg-elevated shadow-[var(--shadow-card)] transition-shadow hover:shadow-[var(--shadow-card-hover)]"
    data-zoom={full.src}
    data-zoom-alt={alt}
    aria-label={`放大查看：${alt}`}
  >
    <Image src={src} alt={alt} widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 720px, 100vw" class="block w-full" />
    {
      marks.map((box, i) => (
        <span
          class="pointer-events-none absolute rounded-md ring-2 ring-accent"
          style={`left:${box[0]}%;top:${box[1]}%;width:${box[2]}%;height:${box[3]}%`}
          aria-hidden="true"
        >
          <span
            class:list={[
              'absolute grid size-5.5 place-items-center rounded-full bg-accent text-xs leading-none font-bold text-white ring-2 ring-white',
              badgePos[edgeOf(box)],
            ]}
          >
            {i + 1}
          </span>
        </span>
      ))
    }
    <span class="absolute right-3 bottom-3 inline-flex items-center gap-1 rounded-md bg-black/60 px-2 py-1 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
      <ZoomIn class="size-3.5" aria-hidden="true" />点击放大
    </span>
  </button>
  <figcaption class="mt-2 text-center text-xs text-muted">
    {label}
    {marks.length > 0 && <span class="sr-only">图中按 1 到 {marks.length} 标出了正文提到的位置</span>}
  </figcaption>
</figure>
