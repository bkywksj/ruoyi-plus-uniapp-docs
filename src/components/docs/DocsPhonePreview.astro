---
// docs 模块的手机实时预览面板（文档页右栏 / 营销页首屏，「组件文档右侧放 H5 演示」；guides 模块用的是 PhonePreview.astro）：iframe 载入预览页 + 扫码预览 + 新窗口打开 + 收起
// 外观：白色卡片 + 深色手机外框；零 JS——收起 / 展开用 <details>，二维码用嵌套 <details>；二维码是静态图（site.mobilePreview.qr，没配就不显示「扫码」）
// data-pagefind-ignore：预览面板的按钮文字不进站内搜索；data-migrate-ignore：迁移逐页比对只看正文
import { site } from '@/site.config';
import { previewHref } from '@/lib/preview.mjs';

interface Props {
  /** 预览页地址：已经过 previewUrl() 解析的绝对地址或站内路径 */
  url: string;
  /** 屏幕高度（px）：文档页右栏 680；营销页首屏里放矮一点 */
  height?: number;
}

const { url, height = 680 } = Astro.props;
const qr = site.mobilePreview.qr;
---

<details open class="group not-prose ry-card !rounded-[22px] p-4" data-phone-preview data-migrate-ignore data-pagefind-ignore>
  <summary class="flex cursor-pointer list-none items-center gap-2 text-[13px] font-semibold [&::-webkit-details-marker]:hidden">
    <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(52,211,153,.18)]" aria-hidden="true"></span>
    移动端预览 · H5
    <span class="ml-auto text-xs font-normal text-muted group-open:hidden">展开</span>
    <span class="ml-auto hidden text-xs font-normal text-muted group-open:inline">收起</span>
  </summary>
  <div
    class="mx-auto mt-4 rounded-[38px] bg-[#0d0f14] p-[8px] shadow-[inset_0_0_0_1.5px_rgba(255,255,255,.14),0_30px_60px_-20px_rgba(0,0,0,.6)]"
  >
    <div class="overflow-hidden rounded-[30px] bg-white" style={`height:${height}px`}>
      <iframe src={url} title="移动端实时预览" loading="lazy" class="size-full border-0"></iframe>
    </div>
  </div>
  <div class="mt-3 grid grid-cols-2 gap-2 text-[12px]">
    <a
      href={previewHref(url)}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center rounded-lg bg-ink/[.05] py-2 text-ink/80 transition-colors hover:bg-ink/[.08] hover:text-ink"
    >
      新窗口打开 ↗
    </a>
    {
      qr && (
        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center justify-center rounded-lg bg-ink/[.05] py-2 text-ink/80 transition-colors hover:bg-ink/[.08] hover:text-ink [&::-webkit-details-marker]:hidden">
            扫码预览
          </summary>
          <div class="absolute right-0 bottom-11 z-20 w-56 rounded-xl bg-white p-3 text-center text-[#0b0d14] shadow-2xl">
            <img src={qr} alt="手机扫码打开预览" width="200" height="200" class="mx-auto size-[200px] object-contain" loading="lazy" />
            <p class="mt-2 break-all text-[#5b6172]">{url}</p>
          </div>
        </details>
      )
    }
  </div>
</details>
