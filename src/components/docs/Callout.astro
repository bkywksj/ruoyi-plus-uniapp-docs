---
// 提示框：tip = 顺手的小技巧、warning = 容易踩的坑、danger = 会丢数据 / 不可撤销的操作。
// 三种语气各用一组语义令牌（brand / accent / danger），换主题时只改 global.css
import { Lightbulb, TriangleAlert, OctagonAlert } from '@lucide/astro';

interface Props {
  type?: 'tip' | 'warning' | 'danger';
  /** 省略时用「提示 / 注意 / 警告」 */
  title?: string;
}

const { type = 'tip', title } = Astro.props;
const style = {
  tip: { box: 'border-brand bg-brand-soft', icon: 'text-brand-ink', Icon: Lightbulb, label: '提示' },
  warning: { box: 'border-accent bg-accent-soft', icon: 'text-accent-ink', Icon: TriangleAlert, label: '注意' },
  danger: { box: 'border-danger bg-danger-soft', icon: 'text-danger-ink', Icon: OctagonAlert, label: '警告' },
}[type];
const { Icon } = style;
---

<aside class:list={['not-prose my-6 rounded-lg border-l-4 px-4 py-3 text-[0.95rem] leading-7', style.box]}>
  <p class="flex items-center gap-1.5 font-semibold text-ink">
    <Icon class:list={['size-4 shrink-0', style.icon]} aria-hidden="true" />
    {title ?? style.label}
  </p>
  <div class="mt-1 text-ink [&_a]:text-brand-ink [&_a]:underline [&_code]:font-mono [&_p+p]:mt-2">
    <slot />
  </div>
</aside>
