---
// 多层侧栏（递归）：固定分组画成小标题 + 列表；可折叠分组（item.collapsed 有值）用原生 <details>，零 JS。
// 当前页所在的分组强制展开（lib/sidebar.ts 的 isGroupOpen）。数据结构与上一篇 / 下一篇的算法见 lib/sidebar.ts
import { containsHref, isGroupOpen, type SidebarItem } from '@/lib/sidebar';

interface Props {
  items: SidebarItem[];
  /** 当前页网址（与 item.href 同一形态） */
  current: string;
  depth?: number;
  /** 固定顶层分组下的列表：不画缩进线，与只有一层分组的站原来的外观一致 */
  plain?: boolean;
}

const { items, current, depth = 0, plain = false } = Astro.props;

const linkClass = (active: boolean) => [
  'block rounded-md px-3 py-1.5 transition-colors',
  active ? 'bg-brand-soft font-medium text-brand-ink' : 'text-muted hover:bg-surface hover:text-ink',
];
---

<ul class:list={[depth === 0 ? 'space-y-0' : plain ? 'space-y-0.5' : 'mt-0.5 space-y-0.5 border-l border-line pl-2']}>
  {
    items.map((item) => {
      const active = !!item.href && !item.external && containsHref({ text: item.text, href: item.href }, current);
      const link = item.href ? (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          class:list={linkClass(active)}
        >
          {item.text}
        </a>
      ) : null;

      // 页面
      if (!item.items) return <li class:list={[depth === 0 && 'mb-0.5']}>{link}</li>;

      // 固定分组（不可折叠）：顶层画成小标题，内层画成次级标题
      if (item.collapsed === undefined) {
        return (
          <li class:list={[depth === 0 ? 'mb-6' : 'mt-1']}>
            {link ?? (
              <p
                class:list={[
                  'px-3',
                  depth === 0 ? 'text-xs font-semibold tracking-wider text-muted' : 'py-1.5 font-medium text-ink',
                ]}
              >
                {item.text}
              </p>
            )}
            <div class:list={[depth === 0 && 'mt-2']}>
              <Astro.self items={item.items} current={current} depth={depth + 1} plain={depth === 0} />
            </div>
          </li>
        );
      }

      // 可折叠分组
      return (
        <li class:list={[depth === 0 ? 'mb-4' : 'mt-0.5']}>
          <details open={isGroupOpen(item, current)} class="group" data-sidebar-group>
            <summary
              class:list={[
                'flex cursor-pointer list-none items-center justify-between gap-2 rounded-md px-3 py-1.5 [&::-webkit-details-marker]:hidden',
                depth === 0 ? 'text-xs font-semibold tracking-wider text-muted' : 'text-muted hover:text-ink',
              ]}
            >
              <span>{item.text}</span>
              <svg
                viewBox="0 0 24 24"
                class="size-3.5 shrink-0 transition-transform group-open:rotate-90"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            {link && <div class="mt-0.5">{link}</div>}
            <Astro.self items={item.items} current={current} depth={depth + 1} />
          </details>
        </li>
      );
    })
  }
</ul>
