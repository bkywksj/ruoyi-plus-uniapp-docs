---
// 全站唯一的截图放大层：原生 <dialog>（自带焦点圈定、Esc 关闭），点任意 [data-zoom] 打开。
// 只在用到截图的布局里放一次，Screenshot 组件本身不带脚本。
// <img> 打开时才创建：静态 HTML 里放一个没有 src / 宽高的空 <img>，会被当成真实图片计入 CLS 检查。
---

<dialog id="lightbox" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/80" aria-label="截图放大查看">
  <form method="dialog" class="contents">
    <button type="submit" id="lightbox-close" class="block cursor-zoom-out p-4 sm:p-8" aria-label="关闭放大"></button>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const holder = document.getElementById('lightbox-close');
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-zoom]');
    if (!trigger || !dialog || !holder) return;
    const img = document.createElement('img');
    img.src = trigger.dataset.zoom ?? '';
    img.alt = trigger.dataset.zoomAlt ?? '';
    img.className = 'max-h-[90vh] max-w-[94vw] rounded-lg shadow-2xl';
    holder.replaceChildren(img);
    dialog.showModal();
  });
  // 点遮罩（dialog 本身）也关闭
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
