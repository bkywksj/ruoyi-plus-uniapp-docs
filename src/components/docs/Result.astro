---
// 「完成后」：告诉读者做完这篇应该看到什么，对不上就说明哪一步漏了
import { CircleCheck } from '@lucide/astro';

interface Props {
  title?: string;
}

const { title = '完成后' } = Astro.props;
---

<section class="not-prose my-10 rounded-xl border border-success/30 bg-success-soft px-5 py-4">
  <p class="flex items-center gap-2 font-semibold text-ink">
    <CircleCheck class="size-5 text-success-ink" aria-hidden="true" />{title}
  </p>
  <div class="mt-1 text-[0.95rem] leading-7 text-ink [&_a]:text-brand-ink [&_a]:underline">
    <slot />
  </div>
</section>
