{
  "name": "ruoyi-plus-uniapp-docs",
  "version": "0.1.0",
  "description": "RuoYi-Plus-UniApp 全栈开发文档（VitePress → Astro 迁移试点）",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-icons.mjs && node scripts/build-llms.mjs && astro dev",
    "build": "node scripts/build-icons.mjs && node scripts/build-llms.mjs && astro check && astro build && pagefind --site dist",
    "build:fast": "node scripts/build-icons.mjs && node scripts/build-llms.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "node scripts/sync/run.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "icons": "node scripts/build-icons.mjs",
    "llms": "node scripts/build-llms.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "deploy": "edgeone pages deploy -n ruoyi-plus-uniapp-doc dist",
    "og": "node scripts/render-og.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm build && pnpm check:seo && pnpm test",
    "agents:sync": "node scripts/sync-agents-skills.mjs",
    "check:skills": "node scripts/validate-skills.mjs",
    "format": "prettier --write .",
    "cache:clear": "node -e \"for (const d of ['.astro','node_modules/.astro']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.2",
    "@iconify-json/lucide": "1.2.118",
    "@iconify-json/simple-icons": "1.2.91",
    "@iconify/utils": "3.1.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^9.0.4",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
