# .npmrc 配置文件 - pnpm/npm 包管理器配置

# ================================
# 镜像源配置
# ================================

# 使用淘宝镜像源，提升国内下载速度
# npmmirror.com 是新的淘宝镜像域名，替代了原来的 cnpmjs.org
registry = https://registry.npmmirror.com

# ================================
# pnpm 依赖管理配置
# ================================

# 关闭严格的 peer dependencies 检查
# 当 peer dependencies 版本不匹配时，不会导致安装失败
# 解决类似 "vite@6.3.5 vs required ^5.2.8" 的版本冲突问题
strict-peer-dependencies=false

# 自动安装 peer dependencies
# 当检测到缺失的 peer dependencies 时，pnpm 会自动安装
# 避免手动处理依赖关系，简化安装过程
auto-install-peers=true

# 启用 shamefully-hoist（无耻提升）
# 将依赖提升到 node_modules 根目录，类似 npm/yarn 的平铺结构
# 解决某些包因为 pnpm 的严格目录结构而无法找到依赖的问题
# 注意：这会牺牲 pnpm 的依赖隔离优势，但提高兼容性
shamefully-hoist=true
